{
  "name": "@seasyecn/opencode-child-compaction",
  "version": "0.2.0",
  "description": "OpenCode plugin that compacts eligible child sessions at an adaptive context threshold.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeasyecN/opencode-child-compaction"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config.json": "./config.json"
  },
  "files": [
    "dist",
    "config.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode/plugin",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.30"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
