{
  "name": "@seasyecn/opencode-child-compaction",
  "version": "0.1.1",
  "description": "OpenCode plugin that compacts eligible child sessions at an adaptive context threshold.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeasyecN/opencode-child-compaction"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "config.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin --external @opencode-ai/sdk",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.23",
    "@opencode-ai/sdk": "1.18.23",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
